[
 {
  "no": 1,
  "level": "上上",
  "poem": [
   "月老亲牵红线来，",
   "前世姻缘今世开。",
   "莫愁前路无知己，",
   "有情之人自会来。"
  ],
  "jie": "此签大吉。月老亲临，前世有约今生来赴。无论目前状态如何，正缘已在路上。",
  "love": "你的姻缘运势极佳。如果是单身，近期有极大可能遇到心动之人；如果已有目标，大胆表白成功率很高。"
 },
 {
  "no": 2,
  "level": "上上",
  "poem": [
   "百年好合在今朝，",
   "金玉良缘不用求。",
   "春风得意马蹄疾，",
   "一日看尽长安花。"
  ],
  "jie": "此签大吉。金玉良缘天注定，无需刻意追寻。春风正暖，万物可期。",
  "love": "不用焦虑，不用刻意。你的正缘会在最自然的状态下出现，越是放松越容易遇到。"
 },
 {
  "no": 3,
  "level": "上上",
  "poem": [
   "双燕归来春正暖，",
   "桃花映面柳含烟。",
   "此情只应天上有，",
   "人间难得几回闻。"
  ],
  "jie": "双燕齐飞，桃花盛开。姻缘之美，如天上人间。",
  "love": "一段非常美好的感情正在向你走来。如果已经有人在身边，这段感情会更加甜蜜。"
 },
 {
  "no": 4,
  "level": "上上",
  "poem": [
   "缘定三生石上书，",
   "今朝得见旧时图。",
   "莫道相逢皆偶然，",
   "天机早在命中铺。"
  ],
  "jie": "三生石上有名，此缘非偶然。命中注定的重逢。",
  "love": "你遇到或即将遇到的那个人，和你有很深的缘分。可能有似曾相识的感觉。"
 },
 {
  "no": 5,
  "level": "上上",
  "poem": [
   "东风送暖百花开，",
   "喜鹊枝头报喜来。",
   "莫问姻缘何处觅，",
   "回头一笑在身旁。"
  ],
  "jie": "东风送暖，喜报频传。回眸之间，缘分就在身边。",
  "love": "注意身边的人，也许你一直在寻找的那个人就在你周围。"
 },
 {
  "no": 6,
  "level": "上上",
  "poem": [
   "红线牵来天作合，",
   "两心相悦不需说。",
   "但愿人长久万里，",
   "共看明月照山河。"
  ],
  "jie": "天作之合，心意相通。千里共婵娟。",
  "love": "你和对方之间有一种不需言语的默契，这是极好的姻缘征兆。"
 },
 {
  "no": 7,
  "level": "上上",
  "poem": [
   "金风玉露一相逢，",
   "便胜却人间无数。",
   "两情若是久长时，",
   "又岂在朝朝暮暮。"
  ],
  "jie": "取自秦观名句。金风玉露之逢，胜过人间无数。",
  "love": "即使目前是异地或有距离，真挚的感情不受距离限制。"
 },
 {
  "no": 8,
  "level": "上上",
  "poem": [
   "明月照人圆又满，",
   "清风送来桂花香。",
   "此生得遇知心人，",
   "不枉来人间一趟。"
  ],
  "jie": "月圆花香，得遇知心。人生圆满之象。",
  "love": "你即将遇到一个非常懂你的人，能读懂你的沉默，理解你的选择。"
 },
 {
  "no": 9,
  "level": "上上",
  "poem": [
   "春江水暖鸭先知，",
   "你心已动缘已至。",
   "不必犹豫不必等，",
   "勇敢迈出第一步。"
  ],
  "jie": "春水先知，你的直觉是对的。",
  "love": "如果你心里已经有了感觉，相信自己的直觉。对方可能也有同样的心思。"
 },
 {
  "no": 10,
  "level": "上上",
  "poem": [
   "天生一对地一双，",
   "命里姻缘不可挡。",
   "纵使千山万水隔，",
   "终究会到彼此旁。"
  ],
  "jie": "命中姻缘，纵有千难万阻终能团圆。",
  "love": "如果目前有困难，不要放弃。时间和真心会解决一切障碍。"
 },
 {
  "no": 11,
  "level": "上",
  "poem": [
   "花开时节又逢君，",
   "一见如故胜故人。",
   "且把闲愁都放下，",
   "笑迎新缘入门来。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 12,
  "level": "上",
  "poem": [
   "小桥流水有人家，",
   "门前桃树正开花。",
   "若问此花开为谁，",
   "只等有缘人到来。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 13,
  "level": "上",
  "poem": [
   "山重水复疑无路，",
   "柳暗花明又一村。",
   "姻缘也在转角处，",
   "不经意间遇见春。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 14,
  "level": "上",
  "poem": [
   "一树梨花压海棠，",
   "春风十里不如你。",
   "此情可待成追忆，",
   "只是当时已惘然。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 15,
  "level": "上",
  "poem": [
   "明月松间照，",
   "清泉石上流。",
   "竹喧归浣女，",
   "有缘自会逢。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 16,
  "level": "上",
  "poem": [
   "踏破铁鞋无觅处，",
   "得来全不费功夫。",
   "寻寻觅觅多少年，",
   "回首灯火阑珊处。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 17,
  "level": "上",
  "poem": [
   "好风凭借力，",
   "送我上青云。",
   "姻缘乘风至，",
   "何须苦追寻。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 18,
  "level": "上",
  "poem": [
   "昨夜西风凋碧树，",
   "独上高楼望天涯。",
   "今日东风花又开，",
   "有缘人自远方来。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 19,
  "level": "上",
  "poem": [
   "人面不知何处去，",
   "桃花依旧笑春风。",
   "来年花开人再来，",
   "对的那人在等候。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 20,
  "level": "上",
  "poem": [
   "有美人兮见之不忘，",
   "一日不见兮思之如狂。",
   "凤飞翱翔兮四海求凰，",
   "奈何佳人兮不在东墙。",
   "——缘分将至，莫急莫慌。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 21,
  "level": "上",
  "poem": [
   "江畔何人初见月，",
   "江月何年初照人。",
   "此刻相逢皆是缘，",
   "好好珍惜眼前人。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 22,
  "level": "上",
  "poem": [
   "众里寻他千百度，",
   "蓦然回首，",
   "那人却在灯火阑珊处。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 23,
  "level": "上",
  "poem": [
   "红豆生南国，",
   "春来发几枝。",
   "愿君多采撷，",
   "此物最相思。",
   "——相思有应，好事将近。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 24,
  "level": "上",
  "poem": [
   "身无彩凤双飞翼，",
   "心有灵犀一点通。",
   "你与ta人心意连，",
   "只差一个开口功。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 25,
  "level": "上",
  "poem": [
   "沉舟侧畔千帆过，",
   "病树前头万木春。",
   "旧情已过新缘来，",
   "放下执念自然开。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 26,
  "level": "上",
  "poem": [
   "天阶夜色凉如水，",
   "坐看牵牛织女星。",
   "星河虽远鹊桥通，",
   "你的鹊桥正在建。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 27,
  "level": "上",
  "poem": [
   "莫道桃花只在春，",
   "四季各有好风景。",
   "缘来不在早晚间，",
   "到了自然就分明。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 28,
  "level": "上",
  "poem": [
   "春有百花秋有月，",
   "夏有凉风冬有雪。",
   "若无闲事挂心头，",
   "便是人间好时节。",
   "——姻缘亦如此，水到渠成。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 29,
  "level": "上",
  "poem": [
   "青青子衿悠悠我心，",
   "纵我不往子宁不嗣音？",
   "你若勇敢迈一步，",
   "对方也在等你行。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 30,
  "level": "上",
  "poem": [
   "人生若只如初见，",
   "何事秋风悲画扇。",
   "此签劝你重初心，",
   "好好珍惜眼前缘。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 31,
  "level": "中上",
  "poem": [
   "云中谁寄锦书来，",
   "雁字回时月满楼。",
   "有心之人终会至，",
   "莫让犹豫误良候。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 32,
  "level": "中上",
  "poem": [
   "欲穷千里目，",
   "更上一层楼。",
   "姻缘需主动，",
   "坐等不如走。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 33,
  "level": "中上",
  "poem": [
   "酒逢知己千杯少，",
   "话不投机半句多。",
   "若觉对了就珍惜，",
   "莫等错过再蹉跎。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 34,
  "level": "中上",
  "poem": [
   "独在异乡为异客，",
   "每逢佳节倍思亲。",
   "思念深处有姻缘，",
   "先把心安归处寻。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 35,
  "level": "中上",
  "poem": [
   "海内存知己，",
   "天涯若比邻。",
   "莫愁前路远，",
   "有缘自会亲。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 36,
  "level": "中上",
  "poem": [
   "月有阴晴圆缺，",
   "人有悲欢离合。",
   "此刻虽有缺憾，",
   "下一个月满时。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 37,
  "level": "中上",
  "poem": [
   "云开月照见花开，",
   "莫向旁人怨苦哀。",
   "若问姻缘归甚处，",
   "东风送暖自然来。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 38,
  "level": "中上",
  "poem": [
   "大江东去浪淘尽，",
   "千古风流人物。",
   "你的风流就在后，",
   "先把自己打磨好。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 39,
  "level": "中上",
  "poem": [
   "竹外桃花三两枝，",
   "春江水暖你先知。",
   "姻缘已到三分二，",
   "再加努力便成事。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 40,
  "level": "中上",
  "poem": [
   "不识庐山真面目，",
   "只缘身在此山中。",
   "也许答案在身边，",
   "退后一步看得清。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 41,
  "level": "中上",
  "poem": [
   "采菊东篱下，",
   "悠然见南山。",
   "无心插柳柳成荫，",
   "感情之事莫强攀。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 42,
  "level": "中上",
  "poem": [
   "莫听穿林打叶声，",
   "何妨吟啸且徐行。",
   "姻缘路上莫心急，",
   "慢慢走来风景好。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 43,
  "level": "中上",
  "poem": [
   "问君能有几多愁，",
   "恰似一江春水向东流。",
   "愁水流尽桃花现，",
   "先把心上愁放走。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 44,
  "level": "中上",
  "poem": [
   "今人不见古时月，",
   "今月曾经照古人。",
   "你要的那个人，",
   "也在月下等某人。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 45,
  "level": "中上",
  "poem": [
   "两岸猿声啼不住，",
   "轻舟已过万重山。",
   "烦恼再多都会过，",
   "前方就是桃花岸。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 46,
  "level": "中",
  "poem": [
   "横看成岭侧成峰，",
   "远近高低各不同。",
   "感情之事无绝对，",
   "换个角度看或通。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 47,
  "level": "中",
  "poem": [
   "山穷水复疑无路，",
   "此路不通换条路。",
   "姻缘不是单行道，",
   "条条大路通幸福。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 48,
  "level": "中",
  "poem": [
   "人间四月芳菲尽，",
   "山寺桃花始盛开。",
   "你的花期或稍晚，",
   "迟来的反而精彩。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 49,
  "level": "中",
  "poem": [
   "飞流直下三千尺，",
   "疑是银河落九天。",
   "姻缘看似遥不可及，",
   "其实近在眼前间。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 50,
  "level": "中",
  "poem": [
   "命里有时终须有，",
   "命里无时莫强求。",
   "该来自然会来到，",
   "不该来的求不到。",
   "——但求不到也别急，缘分有时会迟到。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 51,
  "level": "中",
  "poem": [
   "落霞与孤鹜齐飞，",
   "秋水共长天一色。",
   "时机未到景色已美，",
   "享受当下不必焦虑。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 52,
  "level": "中",
  "poem": [
   "不畏浮云遮望眼，",
   "自缘身在最高层。",
   "你看得比谁都清，",
   "只是缺少一点勇气。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 53,
  "level": "中",
  "poem": [
   "黑发不知勤学早，",
   "白首方悔读书迟。",
   "感情也要早经营，",
   "莫等花落空叹息。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 54,
  "level": "中",
  "poem": [
   "年年岁岁花相似，",
   "岁岁年年人不同。",
   "身边来来又去去，",
   "总有一人留到最后。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 55,
  "level": "中",
  "poem": [
   "千里之行始于足下，",
   "姻缘之路从打招呼开始。",
   "不要想太多先行动，",
   "机会藏在日常中。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 56,
  "level": "中下",
  "poem": [
   "昨夜雨疏风骤，",
   "浓睡不消残酒。",
   "近期桃花有些乱，",
   "分清正缘与过客。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 57,
  "level": "中下",
  "poem": [
   "夕阳无限好，",
   "只是近黄昏。",
   "眼前人或非良人，",
   "长远来看需审慎。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 58,
  "level": "中下",
  "poem": [
   "抽刀断水水更流，",
   "举杯消愁愁更愁。",
   "感情烦恼暂放下，",
   "先把自己的生活调好。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 59,
  "level": "中下",
  "poem": [
   "蜡炬成灰泪始干，",
   "付出太多需看看，",
   "对方是否同等回报，",
   "一厢情愿难长久。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 60,
  "level": "中下",
  "poem": [
   "此情可待成追忆，",
   "只是当时已惘然。",
   "如果总是在回忆里，",
   "就看不到眼前的缘。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 61,
  "level": "中下",
  "poem": [
   "无可奈何花落去，",
   "似曾相识燕归来。",
   "旧缘已去新缘来，",
   "但你需要先放手。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 62,
  "level": "中下",
  "poem": [
   "花开堪折直须折，",
   "莫待无花空折枝。",
   "身边有人就珍惜，",
   "不要总想着更好的。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 63,
  "level": "中下",
  "poem": [
   "春蚕到死丝方尽，",
   "你太执着反而累。",
   "感情不是努力就行，",
   "还需要对的时机和人。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 64,
  "level": "中下",
  "poem": [
   "相见时难别亦难，",
   "东风无力百花残。",
   "此段感情多波折，",
   "需要双方共同努力。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 65,
  "level": "中下",
  "poem": [
   "商女不知亡国恨，",
   "隔江犹唱后庭花。",
   "也许你沉迷的桃花，",
   "并不是真正的正缘。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 66,
  "level": "中下",
  "poem": [
   "多情自古伤离别，",
   "更那堪冷落清秋节。",
   "此刻不宜强求感情，",
   "先度过这段调整期。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 67,
  "level": "中下",
  "poem": [
   "问世间情为何物，",
   "直教人生死相许。",
   "但签名提醒你一句，",
   "别为了感情丢了自己。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 68,
  "level": "中下",
  "poem": [
   "两情若是久长时，",
   "又岂在朝朝暮暮。",
   "若目前有距离和阻碍，",
   "先把各自的日子过好。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 69,
  "level": "中下",
  "poem": [
   "天长地久有时尽，",
   "此恨绵绵无绝期。",
   "这段缘分有隐忧，",
   "需要坦诚面对问题。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 70,
  "level": "中下",
  "poem": [
   "曾经沧海难为水，",
   "除却巫山不是云。",
   "你心里住着一个人，",
   "但那个位置需要腾出来。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 71,
  "level": "下",
  "poem": [
   "林花谢了春红，",
   "太匆匆。",
   "无奈朝来寒雨晚来风。",
   "姻缘暂时受阻，",
   "先顾好自己。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 72,
  "level": "下",
  "poem": [
   "自是人生长恨水长东，",
   "近期感情不如意。",
   "但东流之水终入海，",
   "低谷之后是上坡。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 73,
  "level": "下",
  "poem": [
   "剪不断理还乱，",
   "是离愁。",
   "别是一般滋味在心头。",
   "感情纠缠不清，",
   "需要做一个决定。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 74,
  "level": "下",
  "poem": [
   "无言独上西楼，",
   "月如钩。",
   "寂寞梧桐深院锁清秋。",
   "此刻孤独是常态，",
   "但不会一直这样。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 75,
  "level": "下",
  "poem": [
   "帘卷西风，",
   "人比黄花瘦。",
   "为情所困太久，",
   "该把重心移回自己。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 76,
  "level": "下",
  "poem": [
   "物是人非事事休，",
   "欲语泪先流。",
   "那个人已经不是从前的人，",
   "你也需要往前走。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 77,
  "level": "下",
  "poem": [
   "只恐双溪舴艋舟，",
   "载不动许多愁。",
   "感情的包袱太重，",
   "需要学会放下。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 78,
  "level": "下",
  "poem": [
   "寻寻觅觅冷冷清清，",
   "凄凄惨惨戚戚。",
   "当下感情运势低谷，",
   "但低谷之后必回升。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 79,
  "level": "下",
  "poem": [
   "知否知否，",
   "应是绿肥红瘦。",
   "你付出很多收获很少，",
   "也许方向需要调整。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 80,
  "level": "下",
  "poem": [
   "花自飘零水自流，",
   "一种相思两处闲愁。",
   "有缘无分的阶段，",
   "强求不如等待。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 81,
  "level": "下",
  "poem": [
   "莫道不销魂，",
   "帘卷西风人比黄花瘦。",
   "为情消瘦不值得，",
   "先爱自己再爱人。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 82,
  "level": "下",
  "poem": [
   "渡口无人舟自横，",
   "你等的船暂时没来。",
   "与其苦等不如先上岸，",
   "沿途走走或遇新风景。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 83,
  "level": "下",
  "poem": [
   "独上高楼望尽天涯路，",
   "满眼是雾看不清。",
   "此签劝你暂且歇息，",
   "迷雾散后再出发。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 84,
  "level": "下",
  "poem": [
   "一寸相思一寸灰，",
   "思念太重伤了自己。",
   "把精力放在提升自己，",
   "蝴蝶自来花开之后。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 85,
  "level": "下",
  "poem": [
   "此情可待成追忆，",
   "当下不宜再纠结。",
   "把它放在记忆里，",
   "带着经验继续走。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 86,
  "level": "下下",
  "poem": [
   "风萧萧兮易水寒，",
   "壮士一去不复还。",
   "此签虽有壮烈气，",
   "但签名提醒你：",
   "这段缘分大概率无果，",
   "及时止损为上策。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 87,
  "level": "下下",
  "poem": [
   "国破山河在，",
   "城春草木深。",
   "感觉感怀皆无用，",
   "重建自己为首要。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 88,
  "level": "下下",
  "poem": [
   "前不见古人，",
   "后不见来者。",
   "念天地之悠悠，",
   "独怆然而涕下。",
   "——孤独只是暂时的，",
   "但此刻确实需要独自面对。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 89,
  "level": "下下",
  "poem": [
   "相见争如不见，",
   "有情何似无情。",
   "此刻相见不如怀念，",
   "给彼此一些空间。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 90,
  "level": "下下",
  "poem": [
   "多情却似总无情，",
   "唯觉樽前笑不成。",
   "感情之事勉强不得，",
   "该放手时需放手。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 91,
  "level": "下下",
  "poem": [
   "此情应是长相守，",
   "你若无心我便休。",
   "对方无意则莫强求，",
   "天涯何处无芳草。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 92,
  "level": "下下",
  "poem": [
   "人生到处知何似，",
   "应似飞鸿踏雪泥。",
   "留不住的缘分随它去，",
   "前方还有新天地。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 93,
  "level": "下下",
  "poem": [
   "抽刀断水水更流，",
   "你越是想抓住越是失去。",
   "松开手让缘分自由，",
   "该回来的自然会回来。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 94,
  "level": "下下",
  "poem": [
   "十年生死两茫茫，",
   "不思量自难忘。",
   "这段感情已成过往，",
   "活在过去不如活在未来。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 95,
  "level": "下下",
  "poem": [
   "花谢花飞飞满天，",
   "红消香断有谁怜。",
   "近期桃花多是镜花水月，",
   "不宜轻信甜言蜜语。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 96,
  "level": "下下",
  "poem": [
   "东风恶欢情薄，",
   "一怀愁绪几年离索。",
   "此签提醒你：",
   "这段感情反复折磨，",
   "是时候考虑放手。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 97,
  "level": "下下",
  "poem": [
   "世情薄人情恶，",
   "雨送黄昏花易落。",
   "感情中多有不如意，",
   "但风雨总会过去。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 98,
  "level": "下下",
  "poem": [
   "零落成泥碾作尘，",
   "只有香如故。",
   "虽然这段缘分已碎，",
   "但你从中获得了成长。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 99,
  "level": "下下",
  "poem": [
   "莫道春风不解愁，",
   "春风也有打落花时。",
   "此刻虽是最难熬，",
   "但请记住：",
   "每一个下下签之后，",
   "都藏着一个上上签的开始。"
  ],
  "jie": "",
  "love": ""
 },
 {
  "no": 100,
  "level": "下下转上上",
  "poem": [
   "塞翁失马焉知非福，",
   "破茧成蝶就在此刻。",
   "一百签为最后一签，",
   "也是轮回之签。",
   "失去不是终点，",
   "而是新缘分的起点。",
   "请记住：",
   "命由己造，福自己求。",
   "最好的姻缘，",
   "永远是你成为最好的自己之后，",
   "自然而然到来的那个。"
  ],
  "jie": "",
  "love": ""
 }
]